    -- Drag
    local dragging, dragStart, startPos
    local function clampPos(pos, obj)
        local vp = Workspace.CurrentCamera.ViewportSize
        local size = obj.AbsoluteSize
        local x = math.clamp(pos.X.Offset, -size.X + 40, vp.X - 40)
        local y = math.clamp(pos.Y.Offset, 0, vp.Y - 30)
        return UDim2.new(pos.X.Scale, x, pos.Y.Scale, y)
    end
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    local function doDrag(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            Main.Position = clampPos(UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y), Main)
        end
    end
    TitleBar.InputChanged:Connect(doDrag)
    UserInputService.InputChanged:Connect(doDrag)
    TitleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)


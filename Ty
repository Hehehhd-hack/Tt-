-- UTILITIES
-- ============================================
local function getCharacter()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    return char
end

local function getHRP()
    local char = getCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function isValidNPC(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("Model") then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not obj:FindFirstChild("HumanoidRootPart") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    return true
end

local function getAllNPCs()
    local npcs = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isValidNPC(obj) then
            table.insert(npcs, {
                model = obj,
                humanoid = obj:FindFirstChildOfClass("Humanoid"),
                hrp = obj:FindFirstChild("HumanoidRootPart"),
                name = obj.Name,
            })
        end
    end
    return npcs
end

local function getClosestNPC(filterFn)
    local hrp = getHRP()
    if not hrp then return nil end
    local closest, closestDist = nil, math.huge
    local myPos = hrp.Position
    for _, npc in ipairs(getAllNPCs()) do
        if filterFn and not filterFn(npc) then continue end
        local dist = (npc.hrp.Position - myPos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = npc
        end
    end
    return closest
end

local function equipBestTool()
    local char = getCharacter()
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("gauntlet") then
            pcall(function() hum:EquipTool(tool) end)
            return tool
        end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function() hum:EquipTool(tool) end)
            return tool
        end
    end
    return nil
end

local function fireTouch(hit, target)
    if not hit or not target then return end
    pcall(function()
        firetouchinterest(hit, target, 0)
        task.wait(0.02)
        firetouchinterest(hit, target, 1)
    end)
end

local function findObjectByTerms(terms, types)
    types = types or {"Model", "BasePart"}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local n = obj.Name:lower()
        for _, term in ipairs(terms) do
            if n:find(term) then
                for _, t in ipairs(types) do
                    if obj:IsA(t) then return obj end
                end
            end
        end
    end
    return nil
end

local function fmt(n)
    if n >= 1e9 then return string.format("%.1fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
    return tostring(n)
end

-- ============================================
-- HITBOX EXPANDER (target only)
-- ============================================
local originalSizes = {}

local function expandHitbox(target, size)
    if not target or not target.Parent then return end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not originalSizes[target] then
        originalSizes[target] = { size = hrp.Size, transparency = hrp.Transparency }
    end
    hrp.Size = Vector3.new(size, size, size)
    hrp.Transparency = Config.HitboxTransparency
    hrp.CanCollide = false
    hrp.BrickColor = BrickColor.new("Really red")
end

local function restoreHitbox(target)
    if not target or not target.Parent then return end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local orig = originalSizes[target]
    if orig then
        hrp.Size = orig.size
        hrp.Transparency = orig.transparency
        originalSizes[target] = nil
    end
end

-- ============================================
-- SEQUENTIAL AUTO KILL (one target at a time)
-- ============================================
-- Locks onto a single NPC, teleports player HRP to overlap the NPC hitbox,
-- spams tool activation + touch until the target dies or times out.
-- Then moves to next target.

local function throwAtTarget(npc)
    local hrp = getHRP()
    if not hrp or not npc or not npc.hrp then return false end

    -- Expand target hitbox (optional)
    if Config.ThrowHitbox then
        expandHitbox(npc.model, Config.HitboxSize)
    end

    -- Teleport character directly onto the target hitbox
    pcall(function()
        hrp.CFrame = npc.hrp.CFrame
        hrp.Velocity = Vector3.new(0, 0, 0)
    end)

    return true
end

local function killSingle(npc)
    if not npc or not npc.model or not npc.model.Parent then return false end
    if not npc.humanoid or npc.humanoid.Health <= 0 then return true end

    local hrp = getHRP()
    if not hrp then return false end

    local tool = equipBestTool()
    local startTime = os.clock()
    local initialHealth = npc.humanoid.Health

    -- Lock loop: keep attacking this target until dead or timeout
    while Config.AutoKill do
        if not npc.model.Parent or not npc.humanoid then break end
        if npc.humanoid.Health <= 0 then return true end
        if os.clock() - startTime > Config.KillLockTimeout then return false end

        -- Slam player onto target
        throwAtTarget(npc)

        -- Fire everything
        if tool and tool.Parent and tool:FindFirstChild("Handle") then
            pcall(function()
                firetouchinterest(tool.Handle, npc.hrp, 0)
                task.wait(0.008)
                firetouchinterest(tool.Handle, npc.hrp, 1)
            end)
            -- Also touch all body parts
            for _, part in ipairs(npc.model:GetChildren()) do
                if part:IsA("BasePart") then fireTouch(hrp, part) end
            end
        end

        if tool then pcall(function() tool:Activate() end) end
        pcall(function() LocalPlayer:GetMouse() mouse1click() end)

        task.wait(Config.KillDelay)
    end

    return npc.humanoid.Health <= 0
end

local function autoKillLoop()
    task.spawn(function()
        while Config.AutoKill do
            local target = getClosestNPC()
            if target then
                Config.CurrentTarget = target
                local killed = killSingle(target)
                if killed then
                    State.KillCount = (State.KillCount or 0) + 1
                end
                Config.CurrentTarget = nil
                task.wait(0.05)
            else
                task.wait(0.3)
            end
        end
    end)
end

-- ============================================
-- KILL AURA (multi-target, quick)
-- ============================================
local function killAuraLoop()
    task.spawn(function()
        while Config.KillAura do
            pcall(function()
                local hrp = getHRP()
                if hrp then
                    local tool = equipBestTool()
                    for _, npc in ipairs(getAllNPCs()) do
                        if (npc.hrp.Position - hrp.Position).Magnitude <= Config.AuraRange then
                            if Config.ThrowHitbox then
                                expandHitbox(npc.model, Config.HitboxSize)
                            end
                            if tool and tool:FindFirstChild("Handle") then
                                pcall(function()
                                    firetouchinterest(tool.Handle, npc.hrp, 0)
                                    firetouchinterest(tool.Handle, npc.hrp, 1)
                                end)
                            end
                            if tool then pcall(function() tool:Activate() end) end
                        end
                    end
                    pcall(function() LocalPlayer:GetMouse() mouse1click() end)
                end
            end)
            task.wait(Config.AuraSpeed)
        end
    end)
end

-- ============================================
-- AUTO FARM (loose, spam-nearest)
-- ============================================
local function autoFarmLoop()
    task.spawn(function()
        while Config.AutoFarm do
            pcall(function()
                local npc = getClosestNPC()
                if npc and npc.hrp then
                    local hrp = getHRP()
                    if hrp then
                        hrp.CFrame = npc.hrp.CFrame * CFrame.new(0, 0, 3.5)
                        local tool = equipBestTool()
                        if tool then pcall(function() tool:Activate() end) end
                        pcall(function() LocalPlayer:GetMouse() mouse1click() end)
                        if npc.humanoid.Health <= 0 then
                            State.KillCount = (State.KillCount or 0) + 1
                        end
                    end
                end
            end)
            task.wait(Config.FarmSpeed)
        end
    end)
end

-- ============================================
-- STONES / POWERSTONE
-- ============================================
local function autoCollectStonesLoop()
    task.spawn(function()
        while Config.AutoCollectStones do
            pcall(function()
                local stoneTerms = {
                    { name = "Space",   terms = {"space stone", "spacestone"} },
                    { name = "Reality", terms = {"reality stone", "realitystone"} },
                    { name = "Time",    terms = {"time stone", "timestone"} },
                    { name = "Mind",    terms = {"mind stone", "mindstone"} },
                    { name = "Power",   terms = {"power stone", "powerstone"} },
                    { name = "Soul",    terms = {"soul stone", "soulstone"} },
                }
                for _, stone in ipairs(stoneTerms) do
                    if not Config.StonesCollected[stone.name] then
                        local obj = findObjectByTerms(stone.terms)
                        if obj then
                            local part = obj:IsA("Model")
                                and (obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart"))
                                or obj
                            if part and part:IsA("BasePart") then
                                local hrp = getHRP()
                                if hrp then
                                    hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                                    task.wait(0.3)
                                    fireTouch(hrp, part)
                                    Config.StonesCollected[stone.name] = true
                                    State.StonesCollected[stone.name] = true
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(2)
        end
    end)
end

local function autoPowerStoneLoop()
    task.spawn(function()
        while Config.AutoPowerStone do
            pcall(function()
                local hrp = getHRP()
                if hrp then
                    local obj = findObjectByTerms({"powerstone"})
                    if obj then
                        local target = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                        if target then
                            hrp.CFrame = target.CFrame * CFrame.new(0, 25, 0)
                            hrp.Velocity = Vector3.new(0, -250, 0)
                            task.wait(0.7)
                            hrp.CFrame = target.CFrame * CFrame.new(0, 35, 0)
                            task.wait(0.4)
                        end
                    end
                end
            end)
            task.wait(1)
        end
    end)
end


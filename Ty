    -- ========== DRAG (FULL SCREEN) ==========
    local dragging, dragStart, startPos
    local function clampPos(pos, obj)
        local vp = Workspace.CurrentCamera.ViewportSize
        local size = obj.AbsoluteSize
        local minX = -size.X + 80
        local maxX = vp.X - 20
        local minY = 0
        local maxY = vp.Y - 30
        local x = math.clamp(pos.X.Offset, minX, maxX)
        local y = math.clamp(pos.Y.Offset, minY, maxY)
        return UDim2.new(pos.X.Scale, x, pos.Y.Scale, y)
    end

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    local function doDrag(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            Main.Position = clampPos(UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y), Main)
        end
    end
    Header.InputChanged:Connect(doDrag)
    UserInputService.InputChanged:Connect(doDrag)
    Header.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

